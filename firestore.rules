rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && 
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Admin' ||
        (request.auth.token.email == "aqeelaeo@gmail.com" && request.auth.token.email_verified == true));
    }

    function isPharmacist() {
      return isAuthenticated() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Pharmacist';
    }

    function isStaff() {
      return isAuthenticated() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Staff';
    }

    function hasRole(roles) {
      return isAuthenticated() && 
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in roles ||
        (request.auth.token.email == "aqeelaeo@gmail.com" && request.auth.token.email_verified == true));
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'name', 'email', 'role', 'createdAt']) &&
             data.uid is string && data.uid.size() > 0 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.email is string && data.email.size() > 0 &&
             data.role in ['Admin', 'Pharmacist', 'Staff'] &&
             data.createdAt is string;
    }

    function isValidProduct(data) {
      return data.keys().hasAll(['name', 'genericName', 'category', 'batchNumber', 'expiryDate', 'purchasePrice', 'salePrice', 'quantity', 'manufacturer', 'createdAt', 'updatedAt']) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
             data.genericName is string && data.genericName.size() <= 200 &&
             data.category is string && data.category.size() <= 100 &&
             data.batchNumber is string && data.batchNumber.size() <= 100 &&
             data.expiryDate is string &&
             data.purchasePrice is number && data.purchasePrice >= 0 &&
             data.salePrice is number && data.salePrice >= 0 &&
             data.quantity is number && data.quantity >= 0 &&
             data.manufacturer is string && data.manufacturer.size() <= 200 &&
             (!('barcode' in data) || (data.barcode is string && data.barcode.size() <= 100)) &&
             data.createdAt is string &&
             data.updatedAt is string;
    }

    function isValidCustomer(data) {
      return data.keys().hasAll(['name', 'phone', 'createdAt']) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.phone is string && data.phone.size() <= 50 &&
             (!('address' in data) || (data.address is string && data.address.size() <= 500)) &&
             (!('points' in data) || (data.points is number && data.points >= 0)) &&
             data.createdAt is string;
    }

    function isValidVendor(data) {
      return data.keys().hasAll(['name', 'contactInfo', 'createdAt']) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.contactInfo is string && data.contactInfo.size() <= 200 &&
             (!('address' in data) || (data.address is string && data.address.size() <= 500)) &&
             data.createdAt is string;
    }

    function isValidPurchase(data) {
      return data.keys().hasAll(['vendorId', 'vendorName', 'totalAmount', 'items', 'date', 'createdAt']) &&
             data.vendorId is string && data.vendorId.size() > 0 &&
             data.vendorName is string && data.vendorName.size() > 0 &&
             data.totalAmount is number && data.totalAmount >= 0 &&
             data.items is list && data.items.size() > 0 && data.items.size() <= 100 &&
             data.date is string &&
             data.createdAt is string;
    }

    function isValidSale(data) {
      return data.keys().hasAll(['totalAmount', 'discount', 'tax', 'finalAmount', 'items', 'date', 'createdBy', 'createdAt']) &&
             (!('customerId' in data) || (data.customerId is string && data.customerId.size() > 0)) &&
             (!('customerName' in data) || (data.customerName is string && data.customerName.size() > 0)) &&
             data.totalAmount is number && data.totalAmount >= 0 &&
             data.discount is number && data.discount >= 0 &&
             data.tax is number && data.tax >= 0 &&
             data.finalAmount is number && data.finalAmount >= 0 &&
             data.items is list && data.items.size() > 0 && data.items.size() <= 100 &&
             data.date is string &&
             data.createdBy is string && data.createdBy.size() > 0 &&
             data.createdAt is string;
    }

    function isValidStockLog(data) {
      return data.keys().hasAll(['productId', 'productName', 'type', 'quantity', 'referenceId', 'date']) &&
             data.productId is string && data.productId.size() > 0 &&
             data.productName is string && data.productName.size() > 0 &&
             data.type in ['IN', 'OUT'] &&
             data.quantity is number && data.quantity > 0 &&
             data.referenceId is string && data.referenceId.size() > 0 &&
             data.date is string;
    }

    // ===============================================================
    // Rules
    // ===============================================================
    
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isValidUser(request.resource.data) && 
                    (isAdmin() || (request.auth.uid == userId && request.resource.data.role == 'Staff'));
      allow update: if isAuthenticated() && isValidUser(request.resource.data) && 
                    (isAdmin() || (request.auth.uid == userId && request.resource.data.role == resource.data.role));
      allow delete: if isAdmin();
    }

    match /products/{productId} {
      allow read: if isAuthenticated();
      allow create: if hasRole(['Admin', 'Pharmacist']) && isValidProduct(request.resource.data);
      allow update: if isAuthenticated() && isValidProduct(request.resource.data);
      allow delete: if hasRole(['Admin', 'Pharmacist']);
    }

    match /customers/{customerId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isValidCustomer(request.resource.data);
      allow update: if isAuthenticated() && isValidCustomer(request.resource.data);
      allow delete: if hasRole(['Admin', 'Pharmacist']);
    }

    match /vendors/{vendorId} {
      allow read: if isAuthenticated();
      allow create: if hasRole(['Admin', 'Pharmacist']) && isValidVendor(request.resource.data);
      allow update: if hasRole(['Admin', 'Pharmacist']) && isValidVendor(request.resource.data);
      allow delete: if isAdmin();
    }

    match /purchases/{purchaseId} {
      allow read: if isAuthenticated();
      allow create: if hasRole(['Admin', 'Pharmacist']) && isValidPurchase(request.resource.data);
      allow update: if hasRole(['Admin', 'Pharmacist']) && isValidPurchase(request.resource.data);
      allow delete: if isAdmin();
    }

    match /sales/{saleId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isValidSale(request.resource.data);
      allow update: if isAdmin() && isValidSale(request.resource.data);
      allow delete: if isAdmin();
    }

    match /stockLogs/{logId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isValidStockLog(request.resource.data);
      allow update: if isAdmin() && isValidStockLog(request.resource.data);
      allow delete: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
  }
}
